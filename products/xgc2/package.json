{
  "name": "xgc2-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint src",
    "lint:report": "eslint src",
    "lint:strict": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "check:css": "python3 ../scripts/arch/check_css.py",
    "check:ui-policy": "xgc2-style-policy --root src --html index.html",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --exclude 'src/test/architecture/**'",
    "test:repo-gates": "vitest run src/test/architecture/repository-gates.test.ts",
    "test:policy": "vitest run src/test/architecture/eslint-policy.test.ts src/test/architecture/repository-gates.test.ts src/test/architecture/localization-ownership.test.ts src/test/architecture/markable-host-contract.test.ts",
    "test:coverage": "vitest run --coverage --exclude 'src/test/architecture/**'",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:live": "npm run test:live:remote",
    "test:live:remote": "playwright test --config playwright.live.config.ts remote-workflow.spec.ts",
    "test:live:camera": "playwright test --config playwright.camera.live.config.ts camera-world-browser.spec.ts",
    "test:live:local-fleet-visualization": "node live-tests/local-fleet-visualization-e2e.mjs",
    "test:live:local-fleet-scout": "node live-tests/local-fleet-scout-browser-evidence.mjs",
    "test:live:ugv-remote": "node live-tests/local-fleet-ugv-remote-control-data-plane.mjs",
    "test:live:px4-trajectory": "node live-tests/local-fleet-px4-trajectory-data-plane.mjs",
    "test:live:six-experiments-modes": "node live-tests/six-experiments-mode-browser-evidence.mjs",
    "test:live:local-fleet-experiment-matrix": "node live-tests/local-fleet-experiment-e2e-matrix.mjs",
    "test:contract:local-fleet-experiment-matrix": "node --test live-tests/local-fleet-experiment-e2e-matrix.test.mjs",
    "perf:robot-runtime": "node perf/measure-robot-runtime-mixed.mjs",
    "check:fast": "npm run lint && npm run typecheck",
    "check": "npm run lint && npm run test:unit && npm run test:policy && npm run typecheck",
    "typecheck": "tsc -b && tsc --project tsconfig.build-tools.json",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@xgc2/native-agent": "file:../../common/native-agent/web",
    "@xgc2/ui-react": "https://github.com/XGC-Team/xgc2-ui/releases/download/v0.16.10/xgc2-ui-react-0.16.10.tgz",
    "@xgc2/ui-workflow": "https://github.com/XGC-Team/xgc2-ui/releases/download/v0.16.0/xgc2-ui-workflow-0.4.0.tgz",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.9.3",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-grid-layout": "^2.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@xgc2/ui-policy": "https://github.com/XGC-Team/xgc2-ui/releases/download/policy-v0.16.10/xgc2-ui-policy-0.16.10.tgz",
    "eslint": "^10.4.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.7",
    "esbuild": "0.28.1",
    "undici": "7.28.0"
  }
}
