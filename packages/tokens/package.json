{
  "name": "@xgc2/ui-tokens",
  "version": "0.10.3",
  "description": "Shared XGC2 design tokens and theme contract",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist"],
  "exports": {
    ".": "./dist/index.css",
    "./base.css": "./dist/base.css",
    "./v016.css": "./dist/v016.css",
    "./v016-monochrome.css": "./dist/v016-monochrome.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/theme-contract.test.mjs scripts/validate.test.mjs && node scripts/validate.mjs --tokens ./src/v016.css",
    "typecheck": "node scripts/validate.mjs",
    "validate:v016": "node scripts/validate.mjs --tokens ./src/v016.css"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
